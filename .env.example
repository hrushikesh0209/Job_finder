# Copy this file to .env and fill in only the keys you have.
# launch.py loads it automatically; .env is git-ignored, never commit it.

# AI tools (cover letter, tailored CV, interview prep) - pick any one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Extra job boards (free keys)
